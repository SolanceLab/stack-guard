{
  "description": "stack-guard hooks: the secret guard keeps secret files and keys out of the chat; the update check says when a newer stack-guard is out.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PY=python3; [ \"$OS\" = Windows_NT ] && PY=python; \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/secret_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "PY=python3; [ \"$OS\" = Windows_NT ] && PY=python; \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/secret_guard.py\" --post",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PY=python3; [ \"$OS\" = Windows_NT ] && PY=python; \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/secret_guard.py\" --stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "PY=python3; [ \"$OS\" = Windows_NT ] && PY=python; command -v \"$PY\" >/dev/null 2>&1 && \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/update_check.py\" https://raw.githubusercontent.com/SolanceLab/stack-guard/main/plugins/stack-guard/.claude-plugin/plugin.json stack-guard || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
